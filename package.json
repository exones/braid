{
  "name": "@exones/braid",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "description": "CLI for the braid agent workflow.",
  "type": "module",
  "bin": {
    "braid": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exones/braid.git"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "volta": {
    "node": "26.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter spec test",
    "verify": "pwsh -NoProfile -File ./scripts/Verify.ps1",
    "verify:full": "pwsh -NoProfile -File ./scripts/Verify.ps1 -Full",
    "package:proof": "pwsh -NoProfile -File ./scripts/Test-Package.ps1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "7.0.2"
  }
}
